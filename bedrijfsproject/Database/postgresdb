CREATE TABLE time_slots (
    slot_id SERIAL PRIMARY KEY,
    time_slot TIME NOT NULL,
    point_id INTEGER NOT NULL,
    FOREIGN KEY (point_id) REFERENCES points (point_id) ON DELETE CASCADE
);

WITH time_intervals AS (
    SELECT generate_series(
        TIMESTAMP '2023-01-01 00:00:00',  -- Start time (use any fixed date)
        TIMESTAMP '2023-01-01 23:45:00',  -- End time (same fixed date)
        INTERVAL '15 minutes'            -- Interval
    )::TIME AS time_slot                 -- Cast back to TIME
)
INSERT INTO time_slots (time_slot, room_id)
SELECT time_slot, 1  -- Replace 1 with the desired room_id
FROM time_intervals;


